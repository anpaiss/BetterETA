<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Classificazione fondo via Overpass API (solo con Karoo in tethering/WiFi) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fondo dalle mappe offline del Karoo (/sdcard/offline/maps, con targetSdk 28).
         Serve anche WRITE: la cartella e i file .map sono root:sdcard_rw con mode 660/771,
         e solo il permesso di scrittura dà al processo il gruppo sdcard_rw (1015);
         con il solo READ (gruppo sdcard_r) la lettura è negata. Verificato 05/09. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Popup "mandatory arrival time?" alla partenza (overlay sopra il ride-app) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- Where the Karoo fetches the extension manifest (latest APK, version,
             description) to offer installs and updates from its library. The
             "latest" release URL is stable across releases, so this never changes. -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://github.com/anpaiss/BetterETA/releases/latest/download/manifest.json" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BetterEtaExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

    </application>
</manifest>
