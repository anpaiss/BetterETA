<?xml version="1.0" encoding="utf-8"?>
<!-- Campo singolo: didascalia a sinistra su due righe e valore a destra, entrambi
     autosize per riempire l'altezza della cella. Il layout verticale con valore
     a 28sp e didascalia a 10sp era illeggibile in sella. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_farthest"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tv_farthest_label"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.40"
        android:gravity="center_vertical|start"
        android:paddingEnd="6dp"
        android:text="TO FAR\nPOINT"
        android:textStyle="bold"
        android:textColor="#9E9E9E"
        android:textAllCaps="true"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/tv_farthest_value"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.60"
        android:gravity="center_vertical|end"
        android:text="--.-"
        android:textStyle="bold"
        android:textColor="#FF5823"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="110sp"
        android:autoSizeStepGranularity="2sp" />

</LinearLayout>
