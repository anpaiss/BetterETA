<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard: tre righe uguali, didascalia a sinistra (due righe) e valore a
     destra, tutto autosize per riempire la riga come nei campi singoli.
       1. ETA          orario di arrivo
       2. TO GO ±xm   tempo mancante secondo l'ETA (l'incertezza sta nella
                       didascalia, così il valore resta grande)
       3. PACE VS PLAN oppure, con un MTA impostato, "MTA hh:mm / AHEAD|LATE"
                       col margine: stessa coppia di TextView, cambia solo il testo,
                       perché il renderer del Karoo ignora setViewVisibility.
     I valori hanno lo stesso tetto (56sp): è la misura a cui entra ancora la
     stringa più lunga ("2h 15m") nella sua colonna, così ETA e TO GO escono
     con lo stesso corpo invece di dimensionarsi ciascuno sulla propria larghezza.
     La fascia in basso resta vuota: il banner "next cue" del Karoo copre il
     fondo pagina senza avvisare le estensioni. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_master"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ROW 1: ETA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/tv_master_lbl_eta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34"
            android:gravity="center_vertical|start"
            android:paddingEnd="6dp"
            android:text="ETA"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            android:id="@+id/tv_master_eta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.66"
            android:gravity="center_vertical|end"
            android:text="--:--"
            android:textStyle="bold"
            android:textColor="#FF5823"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeStepGranularity="2sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_master_div1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#9E9E9E" />

    <!-- ROW 2: TIME TO GO ± -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/tv_master_lbl_remaining"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34"
            android:gravity="center_vertical|start"
            android:paddingEnd="6dp"
            android:text="TO GO"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            android:id="@+id/tv_master_remaining"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.66"
            android:gravity="center_vertical|end"
            android:text="--"
            android:textStyle="bold"
            android:textColor="#FF5823"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeStepGranularity="2sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_master_div2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#9E9E9E" />

    <!-- ROW 3: PACE VS PLAN, or MTA + margin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/tv_master_lbl_third"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34"
            android:gravity="center_vertical|start"
            android:paddingEnd="6dp"
            android:text="PACE\nVS PLAN"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            android:id="@+id/tv_master_third"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.66"
            android:gravity="center_vertical|end"
            android:text="--"
            android:textStyle="bold"
            android:textColor="#9E9E9E"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeStepGranularity="2sp" />
    </LinearLayout>

    <!-- Bottom band left to the Karoo's "next cue" ticket -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55" />

</LinearLayout>
