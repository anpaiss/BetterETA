<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ROW 1: BIG ETA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESTIMATED ARRIVAL"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:gravity="center"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tv_master_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/tv_master_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--h --m"
        android:textColor="#00FF00"
        android:textSize="24sp"
        android:gravity="center"
        android:layout_marginTop="-4dp" />

    <!-- SEPARATORE -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginVertical="8dp"
        android:background="#333333" />

    <!-- ROW 2: KM AND ASCENT (route stats) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KM REMAINING" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_master_km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--.- km" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASCENT REMAINING" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_master_ascent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- m" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#333333" />

    <!-- SPEED MODEL SECTION (per-grade learned speed) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LEARNED SPEED BY GRADE"
        android:textColor="#AAAAAA"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">
        <TextView android:id="@+id/tv_b0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descent: --" android:textColor="#888888" android:textSize="13sp" />
        <TextView android:id="@+id/tv_b1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Flat: --" android:textColor="#888888" android:textSize="13sp" />
        <TextView android:id="@+id/tv_b2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Climb: --" android:textColor="#888888" android:textSize="13sp" />
        <TextView android:id="@+id/tv_b3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Steep: --" android:textColor="#888888" android:textSize="13sp" />
        <TextView android:id="@+id/tv_b4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wall: --" android:textColor="#888888" android:textSize="13sp" />
    </LinearLayout>

    <!-- FOOTER: STATUS -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">
        <TextView android:id="@+id/tv_status_msg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="OK" android:textColor="#666666" android:textSize="10sp" />
        <TextView android:id="@+id/tv_gps_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPS ACTIVE" android:textColor="#00AAFF" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
