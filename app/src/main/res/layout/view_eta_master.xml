<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ROW 1: BIG ETA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESTIMATED ARRIVAL"
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tv_master_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textColor="#FF5823"
        android:textSize="64sp"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/tv_master_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--h --m"
        android:textColor="#FF5823"
        android:textSize="24sp"
        android:gravity="center" />

    <!-- DIVIDER (TextView with bg color, no <View>) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#888888" />

    <!-- ROW 2: KM AND ASCENT (route stats) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KM REMAINING" android:textColor="#888888" android:textSize="10sp" />
            <TextView android:id="@+id/tv_master_km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--.- km" android:textColor="#FF5823" android:textSize="32sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASCENT REMAINING" android:textColor="#888888" android:textSize="10sp" />
            <TextView android:id="@+id/tv_master_ascent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- m" android:textColor="#FF5823" android:textSize="32sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- DIVIDER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#888888" />

    <!-- PREDICTED AVG SPEED (riempie lo spazio liberato dai bucket) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREDICTED AVG SPEED"
            android:textColor="#888888"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/tv_master_avgspeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km/h"
            android:textColor="#FF5823"
            android:textSize="40sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- FOOTER: STATUS / GPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tv_status_msg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="OK" android:textColor="#888888" android:textSize="10sp" />
        <TextView android:id="@+id/tv_gps_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPS ACTIVE" android:textColor="#FF5823" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
