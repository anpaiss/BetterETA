<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BetterETA"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elevation-aware ETA for Komoot routes"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add the &quot;BetterETA Dashboard&quot;,\n&quot;ETA (Better)&quot; or &quot;Time Remaining (Better)&quot;\nfields to your Karoo ride profile."
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5" />

    <!-- INFO: modello velocità appreso (snapshot salvato a ogni pausa/stop) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:background="#444444" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEARNED SPEED BY GRADE"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <TextView android:id="@+id/tv_b0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descent: --" android:textColor="#888888" android:textSize="15sp" />
    <TextView android:id="@+id/tv_b1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flat: --" android:textColor="#888888" android:textSize="15sp" />
    <TextView android:id="@+id/tv_b2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Climb: --" android:textColor="#888888" android:textSize="15sp" />
    <TextView android:id="@+id/tv_b3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Steep: --" android:textColor="#888888" android:textSize="15sp" />
    <TextView android:id="@+id/tv_b4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wall: --" android:textColor="#888888" android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_model_overall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No data yet"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

    <!-- Learned effective power of the physics model (shadow), assisted / unassisted regime -->
    <TextView
        android:id="@+id/tv_model_physics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <!-- STATS: confronto ETA BetterEta vs ETA nativa Karoo (ultime 20 uscite) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#444444" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ETA VS KAROO — LAST 20 RIDES"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_results_avg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No data yet"
        android:textColor="#FF5823"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Shadow physics fallback vs the production factors, on the same rides -->
    <TextView
        android:id="@+id/tv_results_physics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_results_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>
</ScrollView>
