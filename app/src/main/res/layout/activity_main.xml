<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BetterETA"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elevation-aware ETA for Komoot routes"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add the &quot;BetterETA Dashboard&quot;,\n&quot;ETA (Better)&quot; or &quot;Time Remaining (Better)&quot;\nfields to your Karoo ride profile."
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5" />

    <!-- Stile dei campi: stessi preset WCAG di AxsRatio (TileStyle) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:background="#444444" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FIELD STYLE"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/sp_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Anteprima dal vivo dello stile selezionato, popolata da MainActivity -->
    <LinearLayout
        android:id="@+id/style_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp" />

    <!-- Popup MTA alla partenza: serve il permesso overlay (come PoiAhead) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:background="#444444" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MANDATORY ARRIVAL TIME"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="At ride start a popup asks for a mandatory arrival time.\nThe dashboard and the &quot;Arrival Margin (MTA)&quot; field then show your slack.\nThe popup needs the overlay permission."
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_overlay_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overlay permission: --"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_grant_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allow popup (overlay permission)" />

    <!-- Fondo dalle mappe offline del Karoo: serve la lettura dello storage -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SURFACE FROM OFFLINE MAPS"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Road surface (paved / gravel / trail) is read from the Karoo's own offline maps, no network needed. Overpass is the fallback."
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_storage_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Offline maps: --"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_grant_storage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allow reading offline maps" />

    <!-- Storico FIT: i giri passati alimentano il modello come se l'estensione ci fosse stata -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RIDE HISTORY"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Past rides recorded by the Karoo are replayed into the speed model once: gradient and surface buckets, per-way memory. Runs by itself after start; this button re-checks for new files."
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_history_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ride history: --"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/sp_history_months"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_import_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Import new rides" />

    <Button
        android:id="@+id/btn_rebuild_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rebuild model from history (resets learning)" />

    <Button
        android:id="@+id/btn_forget_last_ride"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Last ride: nothing to undo" />

    <!-- INFO: modello velocità appreso (snapshot salvato a ogni pausa/stop) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#444444" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEARNED SPEED BY GRADE"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <!-- Bucket pendenza × fondo, in km/h con i campioni sotto (popolata da MainActivity) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TableLayout
            android:id="@+id/table_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shrinkColumns="*"
            android:stretchColumns="*" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_model_overall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No data yet"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

    <!-- Learned effective power of the physics model (shadow), assisted / unassisted regime -->
    <TextView
        android:id="@+id/tv_model_physics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <!-- STATS: confronto ETA BetterEta vs ETA nativa Karoo (ultime 20 uscite) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="#444444" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ETA VS KAROO — LAST 20 RIDES"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_results_avg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No data yet"
        android:textColor="#FF5823"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Shadow physics fallback vs the production factors, on the same rides -->
    <TextView
        android:id="@+id/tv_results_physics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_results_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>
</ScrollView>
