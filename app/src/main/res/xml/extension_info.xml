<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@drawable/ic_launcher_foreground"
    id="better-eta"
    scansDevices="false">

    <!-- Full dashboard — single page with arrival, time, km, ascent, model -->
    <DataType
        typeId="eta-master"
        displayName="@string/eta_master_name"
        description="@string/eta_master_desc"
        graphical="true"
        icon="@drawable/ic_launcher_foreground" />

    <!-- Absolute ETA — arrival time HH:mm -->
    <DataType
        typeId="eta-absolute"
        displayName="@string/eta_absolute_name"
        description="@string/eta_absolute_desc"
        graphical="true"
        icon="@drawable/ic_launcher_foreground" />

    <!-- Time remaining — Xh Ym -->
    <DataType
        typeId="eta-remaining"
        displayName="@string/eta_remaining_name"
        description="@string/eta_remaining_desc"
        graphical="true"
        icon="@drawable/ic_launcher_foreground" />

    <!-- Distance to the farthest point from the start (out-and-back turnaround) -->
    <DataType
        typeId="eta-farthest"
        displayName="@string/eta_farthest_name"
        description="@string/eta_farthest_desc"
        graphical="true"
        icon="@drawable/ic_launcher_foreground" />

    <!-- Mandatory time of arrival and the margin against it -->
    <DataType
        typeId="eta-margin"
        displayName="@string/eta_margin_name"
        description="@string/eta_margin_desc"
        graphical="true"
        icon="@drawable/ic_launcher_foreground" />

    <!-- Pace vs plan: riding time against the first estimate of the ride -->
    <DataType
        typeId="eta-pace"
        displayName="@string/eta_pace_name"
        description="@string/eta_pace_desc"
        graphical="true"
        icon="@drawable/ic_launcher_foreground" />

    <!-- Switches (KarooSwitches): the MTA with −15/−5/+5/+15 and the switches of the other extensions -->
    <DataType
        typeId="switches"
        displayName="@string/switches_name"
        description="@string/switches_desc"
        graphical="true"
        icon="@drawable/ic_launcher_foreground" />

</ExtensionInfo>
