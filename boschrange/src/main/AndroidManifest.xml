<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Surface classification falls back to the Overpass API when the offline maps do not cover the route -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Surface from the Karoo offline maps (/sdcard/offline/maps, targetSdk 28); WRITE is what grants the sdcard_rw group, see BetterETA -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Battery popups: overlay windows over the ride app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Bosch Live Data Interface: the Karoo advertises as an LDI accessory and reads the bike (LdiLink).
         targetSdk 28: the legacy pair is what counts on Android 12, the two new ones are declared for a future target bump -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- No io.hammerhead.karooext.MANIFEST_URL yet: the repository is private
             (a 404 there makes the Extensions library show RETRY, see PoiAhead). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tap on a boschRange field or page: opens "Battery now?" (PendingIntent from our own RemoteViews) -->
        <receiver
            android:name=".BatteryTapReceiver"
            android:exported="false" />

        <service
            android:name=".BoschRangeExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

    </application>
</manifest>
