<?xml version="1.0" encoding="utf-8"?>
<!-- Provisional debug field: one big number and up to ten text lines. Text sizes
     are set from code (full page vs half page). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BOSCHRANGE DEBUG"
        android:textColor="@color/page_muted"
        android:textSize="12sp"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tv_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/page_text"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView android:id="@+id/tv_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_text" android:maxLines="1" />
    <TextView android:id="@+id/tv_l2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_text" android:maxLines="1" />
    <TextView android:id="@+id/tv_l3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_text" android:maxLines="1" />
    <TextView android:id="@+id/tv_l4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_text" android:maxLines="1" />
    <TextView android:id="@+id/tv_l5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_muted" android:maxLines="1" />
    <TextView android:id="@+id/tv_l6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_muted" android:maxLines="1" />
    <TextView android:id="@+id/tv_l7" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_muted" android:maxLines="1" />
    <TextView android:id="@+id/tv_l8" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_muted" android:maxLines="1" />
    <TextView android:id="@+id/tv_l9" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_text" android:maxLines="1" />
    <TextView android:id="@+id/tv_l10" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/page_muted" android:maxLines="1" />
</LinearLayout>
