<?xml version="1.0" encoding="utf-8"?>
<!-- Single-cell fields (compact, margin, extra climb): caption, value, sub-caption.
     Text sizes follow the cell, set from code. A tap anywhere opens "Battery now?". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/tv_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/page_muted"
        android:textSize="12sp"
        android:maxLines="1"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/page_text"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/page_muted"
        android:textSize="12sp"
        android:maxLines="1" />
</LinearLayout>
