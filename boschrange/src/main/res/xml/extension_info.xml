        graphical="true"
        icon="@drawable/ic_launcher" />

    <DataType
        typeId="bike_cadence"
        displayName="@string/field_bike_cadence_name"
        description="@string/field_bike_cadence_desc"
        graphical="true"
        icon="@drawable/ic_launcher" />

    <DataType
        typeId="bike_odometer"
        displayName="@string/field_bike_odometer_name"
        description="@string/field_bike_odometer_desc"
        graphical="true"
        icon="@drawable/ic_launcher" />

    <DataType
        typeId="bike_light"
        displayName="@string/field_bike_light_name"
        description="@string/field_bike_light_desc"
        graphical="true"
        icon="@drawable/ic_launcher" />

</ExtensionInfo>
